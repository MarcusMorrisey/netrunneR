# R session/build artifacts and the local renv library, never committed
.Rproj.user
.Rhistory
.RData
.Ruserdata
renv/library

# build_revision()'s installed-tree mirror of R/ and renv.lock: created by
# the Dockerfile and by `make check`'s pre-check step, never committed.
inst/pkg-src

# R CMD check output directory
netrunneR.Rcheck/

# pkgdown-generated site output: rebuilt on demand via pkgdown::build_site(),
# never committed.
docs/

# testthat writes a reproduction script here for each failing test; it is
# a debugging artifact of one run, never something to commit.
tests/testthat/_problems/
